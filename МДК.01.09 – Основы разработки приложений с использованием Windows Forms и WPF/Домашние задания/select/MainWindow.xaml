<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор площади фигур" Height="350" Width="400">
    <StackPanel Margin="20">
        <TextBlock Text="Выберите фигуру:" FontSize="14" Margin="0,0,0,5"/>
        <ComboBox x:Name="cmbFigures" SelectedIndex="0" Margin="0,0,0,15">
            <ComboBoxItem Content="Круг"/>
            <ComboBoxItem Content="Прямоугольник"/>
            <ComboBoxItem Content="Треугольник"/>
        </ComboBox>

        <StackPanel x:Name="spInput" Margin="0,0,0,15">
            <TextBlock Text="Радиус:"/>
            <TextBox x:Name="txtRadius"/>
        </StackPanel>

        <Button x:Name="btnCalc" Content="Рассчитать площадь" Click="btnCalc_Click" Margin="0,0,0,15" Height="30"/>

        <TextBlock Text="Результат:" FontSize="14" Margin="0,0,0,5"/>
        <TextBox x:Name="txtResult" IsReadOnly="True" Height="50" TextWrapping="Wrap"/>
    </StackPanel>
</Window>