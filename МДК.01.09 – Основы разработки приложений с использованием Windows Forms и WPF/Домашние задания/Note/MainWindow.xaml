<Window x:Class="NotesManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NotesManager"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Style="{StaticResource MaterialDesignWindow}">
    <Grid Margin="10" Background="{DynamicResource MaterialDesignDarkSeparatorBackground}">
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <!-- левая часть -->
        <ListBox x:Name="ListBoxNotes" Margin="10" BorderBrush="DarkBlue" BorderThickness="1" SelectionChanged="ListBoxSelect">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="5" Background="LightBlue">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}" FontSize="10"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Column="1" Margin="10" Background="LightGray">
            <TextBlock Text="Заголовок" FontWeight="Bold"/>
            <TextBox x:Name="tBxTitle" Margin="10, 5, 10, 10" Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

            <TextBlock Text="Содержание" FontWeight="Bold"/>
            <TextBox x:Name="tBxContent" Margin="10, 5, 10, 10" Height="150"
                     VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Дата создания" FontWeight="Bold"/>
                <TextBlock x:Name="tBxDate" FontWeight="Bold"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 20">
                <Button x:Name="btnAdd" Content="Добавить" Width="100" Height="30" Background="LightBlue" Margin="5, 0"
                        Style="{StaticResource MaterialDesignFlatDarkButton}" Foreground="DarkBlue" Click="AddButtonClick"/>
                <Button x:Name="btnSave" Content="Сохранить" Width="105" Height="30" Background="LightGreen" Margin="5, 0"
                        Style="{StaticResource MaterialDesignFlatDarkButton}" Foreground="DarkGreen" Click="SaveButtonClick"/>
                <Button x:Name="btnDelete" Content="Удалить" Width="100" Height="30" Background="OrangeRed" Margin="5, 0"
                        Style="{StaticResource MaterialDesignFlatDarkButton}" Foreground="DarkRed" Click="DeleteButtonClick"/>
                <Button x:Name="btnClear" Content="Очистка" Width="90" Height="30" Background="Gray" Margin="10, 0"
                        Style="{StaticResource MaterialDesignFlatDarkButton}" Foreground="White" Click="btnClear_Click"/>
            </StackPanel>
            
            <TextBlock x:Name="tBxStatus" FontWeight="Bold" Margin="10"/> 
        </StackPanel>
    </Grid>
</Window>
